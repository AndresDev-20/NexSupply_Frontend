# =====================================================================
# NexSupply — Variables de entorno del frontend (EJEMPLO)
# Copia este archivo como .env.local. Solo las variables con prefijo
# VITE_ llegan al navegador: NUNCA pongas secretos aquí.
# =====================================================================

# Ruta base de la API. En desarrollo y producción la API se sirve en el
# mismo dominio bajo /api/v1 (proxy de Vite en desarrollo, Nginx en producción).
VITE_API_BASE_URL=/api/v1

# Tiempo máximo de espera de una petición, en milisegundos
VITE_API_TIMEOUT_MS=15000

# Solo desarrollo: a dónde reenvía Vite las peticiones /api.
# Usa 127.0.0.1 (no "localhost"): Node 22 resuelve localhost como IPv6
# y el backend escucha en IPv4, lo que produce un error 502.
VITE_DEV_API_TARGET=http://127.0.0.1:4001
