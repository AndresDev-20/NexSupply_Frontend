# NexSupply — variables del frontend para PRODUCCIÓN (Netlify).
# Vite las lee al compilar (npm run build). Solo van datos públicos: nada de claves.
# Dirección de la API del backend (termina en /api/v1). D-LOC-1: el backend corre en el portátil
# del negocio, en el mismo equipo donde se abre el navegador.
VITE_API_BASE_URL=http://localhost:4001/api/v1
VITE_API_TIMEOUT_MS=15000
